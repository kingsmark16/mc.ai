PORT=3005
NODE_ENV=development
ENABLE_DIAGNOSTIC_ENDPOINTS=false
# In production, set NODE_ENV=production and use the exact HTTPS frontend URL.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

GOOGLE_API_KEY=replace_with_your_google_api_key
GOOGLE_MODEL=gemini-3.1-flash-lite
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001

ASTRA_DB_API_ENDPOINT=https://your-database-id-your-region.apps.astra.datastax.com
ASTRA_DB_APPLICATION_TOKEN=replace_with_your_astra_application_token
ASTRA_DB_KEYSPACE=default_keyspace
# Use a new collection when upgrading an older collection that only indexed
# `source`; visitor isolation also requires the indexed `ownerId` field.
ASTRA_DB_COLLECTION=rag_documents_private
